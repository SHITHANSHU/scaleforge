{
  "schemaVersion": 1,
  "id": "the-backup-that-wasnt-defaults",
  "name": "The backup that wasn't (defaults)",
  "nodes": [
    {
      "id": "users",
      "kind": "client",
      "label": "Users",
      "config": {
        "share": 100,
        "readRatio": 0.45,
        "payloadKB": 2,
        "retries": 0,
        "backoffMs": 100,
        "backoffMultiplier": 2,
        "jitter": 0.5,
        "retryBudgetPct": 100
      },
      "x": 0,
      "y": 220
    },
    {
      "id": "app",
      "kind": "app-service",
      "config": {
        "pods": 6,
        "maxPods": 40,
        "vcpuPerPod": 2,
        "cpuMsPerReq": 5,
        "startupSec": 40,
        "queueLimit": 400,
        "costPerPodHour": 0.09,
        "hpa": false,
        "hpaMetric": "cpu",
        "hpaTarget": 0.6,
        "hpaCooldownSec": 30,
        "maxStepPods": 4,
        "scaleDownDelaySec": 120,
        "strategy": "rolling",
        "maxSurgePct": 25,
        "canaryPct": 10,
        "canaryHoldSec": 60,
        "autoRollback": false,
        "rollbackErrorPct": 5,
        "detectSec": 30,
        "gracefulSec": 15,
        "cacheFallback": false
      },
      "x": 260,
      "y": 220
    },
    {
      "id": "db",
      "kind": "replicated-db",
      "config": {
        "replicas": 2,
        "replication": "async",
        "syncCopies": 1,
        "syncRttMs": 2,
        "shipLagSec": 0.3,
        "readRouting": "replicas",
        "maxStalenessSec": 2,
        "writeLocalitySec": 5,
        "readQps": 5000,
        "writeQps": 3000,
        "applyQps": 3000,
        "queryMs": 4,
        "maxConnections": 300,
        "poolMultiplex": 1,
        "queueDuringFailover": false,
        "queueLimit": 20000,
        "failover": "auto",
        "detectSec": 10,
        "manualResponseSec": 300,
        "promoteSec": 15,
        "fencing": true,
        "dataGB": 150,
        "restoreMBps": 120,
        "replayQps": 8000,
        "snapshotIntervalSec": 600,
        "walArchive": false,
        "backupVerification": false,
        "replicaPlacement": "same-region",
        "costPerNodeHour": 0.35
      },
      "x": 560,
      "y": 220
    }
