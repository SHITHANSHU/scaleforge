  "edges": [
    {
      "id": "e1",
      "from": "users",
      "fromPort": "out",
      "to": "app",
      "toPort": "in",
      "protocol": "http",
      "latencyMs": 1
    },
    {
      "id": "e2",
      "from": "app",
      "fromPort": "db",
      "to": "db",
      "toPort": "in",
      "protocol": "database",
      "latencyMs": 1
    }
  ],
  "scenario": {
    "name": "Corruption",
    "durationSec": 3600,
    "seed": 42,
    "traffic": {
      "type": "constant",
      "rps": 1800
    },
    "faults": [
      {
        "id": "bad",
        "kind": "bad-write",
        "target": "kind:replicated-db",
        "atSec": 1000,
        "params": {
          "detectSec": 300
        }
      }
    ],
    "tickMs": 50
  },
  "updatedAt": 0
}