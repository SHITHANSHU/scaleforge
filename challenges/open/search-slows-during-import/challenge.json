        "name": "Feed running",
        "durationSec": 300,
        "seed": 42,
        "traffic": {
          "type": "constant",
          "rps": 10000
        },
        "faults": [],
        "tickMs": 20
      }
    }
  ],
  "successCriteria": [
    {
