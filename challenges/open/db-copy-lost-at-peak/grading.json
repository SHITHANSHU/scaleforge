      "after": 20,
      "op": "<=",
      "value": 300,
      "limit": 1500
    },
    {
      "id": "stale",
      "label": "Stale reads < 5%",
      "weight": 2,
      "scenario": "all",
      "metric": "replicated-db.staleReadRate",
      "agg": "mean",
      "op": "<",
      "value": 0.05,
      "limit": 0.3
    },
    {
      "id": "write-recover",
      "label": "Write downtime ≤ 40 s (primary loss)",
      "hard": true,
      "weight": 3,
      "scenario": "primary-loss",
      "metric": "replicated-db.downtimeSec",
      "agg": "last",
      "op": "<=",
      "value": 40,
      "limit": 120
    },
    {
      "id": "cost",
      "label": "Cost ≤ $3.5/h (target)",
      "weight": 1,
      "scenario": "peak-loss",
      "metric": "e2e.costPerHour",
