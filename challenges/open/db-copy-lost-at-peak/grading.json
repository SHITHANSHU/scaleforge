  "criteria": [
    {
      "id": "avail",
      "label": "Overall availability ≥ 98.5%",
      "hard": true,
      "weight": 4,
      "scenario": "all",
      "metric": "e2e.availability",
      "agg": "mean",
      "op": ">=",
