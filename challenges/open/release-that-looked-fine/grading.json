  "criteria": [
    {
      "id": "blast",
      "label": "Errors ≤ 1.5% of all requests",
      "hard": true,
      "weight": 4,
      "scenario": "all",
      "metric": "e2e.errorRate",
      "agg": "mean",
      "op": "<=",
      "value": 0.015,
      "limit": 0.1
    },
    {
      "id": "recover",
      "label": "Healthy within 180 s of the release",
      "hard": true,
      "weight": 3,
      "scenario": "bad",
      "metric": "e2e.availability",
      "agg": "settleSec",
      "after": 60,
      "settle": 0.99,
      "op": "<=",
      "value": 180,
      "limit": 400
    },
    {
      "id": "capacity",
      "label": "A good release doesn't cost availability",
      "hard": true,
      "weight": 3,
      "scenario": "good",
      "metric": "e2e.errorRate",
      "agg": "max",
      "op": "<=",
      "value": 0.01,
      "limit": 0.2
    }
  ]
